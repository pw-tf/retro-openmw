// Retro: pixelation, posterize / palette colour mapping and ordered dithering.
// OpenMW port of "Retro Skyrim" by monobelisk (ENB, Skyrim SE, Nexus mod 38464).
// Pair it with retro_crt.omwfx, placed after this shader, for the CRT look.

uniform_int uPalette {
    default = 1;
    display_name = "Palette";
    description = "Colour palette. 'Posterize' quantises each channel to 'Colours per channel' instead of using a palette.";
    widget_type = choice(
        "Posterize (no palette)" = 0,
        "PAL (Retro Skyrim default)" = 1,
        "Deluxe Paint" = 2,
        "Game Boy" = 3,
        "Virtual Boy" = 4,
        "Monochrome (4 greys)" = 5,
        "CGA (cyan / magenta)" = 6,
        "CGA / EGA (16 colours)" = 7,
        "EGA / Master System (64)" = 8,
        "Teletext / BBC Micro (8)" = 9,
        "ZX Spectrum" = 10,
        "Commodore 64" = 11,
        "MSX" = 12,
        "Apple II" = 13,
        "Macintosh II" = 14,
        "PICO-8" = 15,
        "Amstrad CPC (27)" = 16,
        "NES" = 17,
        "8-bit RGB (3-3-2)" = 18
    );
}

uniform_int uColorCount {
    default = 5;
    min = 2;
    max = 255;
    step = 1;
    display_name = "Colours per channel";
    description = "Posterize only: number of levels per colour channel.";
}

uniform_int uResDiv {
    default = 5;
    min = 1;
    max = 48;
    step = 1;
    display_name = "Pixel size";
    description = "Size of a retro pixel in screen pixels, relative to 1080p. Keep it equal to 'Pixel size' in Retro CRT.";
}

uniform_float uDitherStrength {
    default = 1.0;
    min = 0.0;
    max = 4.0;
    step = 0.05;
    display_name = "Dither strength";
}

uniform_float uDitherPower {
    default = 1.0;
    min = 0.01;
    max = 5.0;
    step = 0.05;
    display_name = "Dither power";
}

uniform_bool uInvertEdge {
    default = false;
    display_name = "Invert edge brightness";
    description = "Partially invert the brightness of object outlines.";
}

sampler_3d retroPalettes {
    source = "textures/retro/palettes.dds";
    min_filter = nearest;
    mag_filter = nearest;
    wrap_s = clamp_to_edge;
    wrap_t = clamp_to_edge;
    wrap_r = clamp_to_edge;
}

fragment retro {
    omw_In vec2 omw_TexCoord;

    // Number of palettes stacked in palettes.dds (see tools/make_palettes.py).
    const float PALETTE_COUNT = 18.0;

    // Skyrim's near plane. The ENB shader works on Skyrim's non-linear depth, which is
    // ~(1 - near / z); converting from OpenMW's linear depth keeps the same edge response.
    const float SKYRIM_NEAR = 15.0;
    const float EDGE_STR = 850.0;

    const float SATPOW = 0.5;
    const float BRIGHTPOW = 0.45;
    const float CONTRAST = 1.2;
    const float EDGE_CONTRAST = 1.6;

    // round() for GLSL 1.20. The middle pixel of each retro pixel lands exactly on .5,
    // where the ENB's round() was decided by float noise (uneven, jagged blocks).
    // Ties are always rounded down here so every block has the same size.
    vec2 roundv(vec2 v)
    {
        return floor(v + 0.4999);
    }

    float resDiv()
    {
        return max(1.0, floor(float(uResDiv) / 1080.0 * omw.resolution.y + 0.5));
    }

    // Low resolution grid size. Truncated to whole pixels like the ENB shader's int2.
    vec2 loRes()
    {
        return floor(omw.resolution / resDiv());
    }

    // Emulates the ENB's point sampler on a full resolution buffer.
    vec2 pointUv(vec2 uv)
    {
        return (floor(uv * omw.resolution) + 0.5) / omw.resolution;
    }

    // Centre of the low resolution pixel containing uv.
    vec2 lUv(vec2 uv)
    {
        return (roundv(pointUv(uv) * loRes()) + 0.5) / loRes();
    }

    vec3 RGBtoHSV(vec3 RGB)
    {
        float Epsilon = 1e-10;
        vec4 P = (RGB.g < RGB.b) ? vec4(RGB.bg, -1.0, 2.0 / 3.0) : vec4(RGB.gb, 0.0, -1.0 / 3.0);
        vec4 Q = (RGB.r < P.x) ? vec4(P.xyw, RGB.r) : vec4(RGB.r, P.yzx);
        float C = Q.x - min(Q.w, Q.y);
        float H = abs((Q.w - Q.y) / (6.0 * C + Epsilon) + Q.z);
        float S = C / (Q.x + Epsilon);
        return vec3(H, S, Q.x);
    }

    vec3 HSVtoRGB(vec3 HSV)
    {
        float H = HSV.x;
        float R = abs(H * 6.0 - 3.0) - 1.0;
        float G = 2.0 - abs(H * 6.0 - 2.0);
        float B = 2.0 - abs(H * 6.0 - 4.0);
        vec3 RGB = clamp(vec3(R, G, B), 0.0, 1.0);
        return ((RGB - 1.0) * HSV.y + 1.0) * HSV.z;
    }

    float DitherMask(vec2 luv, vec2 resolution)
    {
        const float mask[64] = float[64](
            0.0, 48.0, 12.0, 60.0, 3.0, 51.0, 15.0, 63.0,
            32.0, 16.0, 44.0, 28.0, 35.0, 19.0, 47.0, 31.0,
            8.0, 56.0, 4.0, 52.0, 11.0, 59.0, 7.0, 55.0,
            40.0, 24.0, 36.0, 20.0, 43.0, 27.0, 39.0, 23.0,
            2.0, 50.0, 14.0, 62.0, 1.0, 49.0, 13.0, 61.0,
            34.0, 18.0, 46.0, 30.0, 33.0, 17.0, 45.0, 29.0,
            10.0, 58.0, 6.0, 54.0, 9.0, 57.0, 5.0, 53.0,
            42.0, 26.0, 38.0, 22.0, 41.0, 25.0, 37.0, 21.0
        );

        vec2 res = mod(floor(luv * resolution), 8.0);

        return mask[int(res.x + res.y * 8.0)] / 63.0;
    }

    vec3 GetLookupColor(vec3 c, vec2 uv, vec2 resolution, float colorCount)
    {
        float maxColors = 16777216.0;
        float avgDist = (log(maxColors - colorCount) / log(3.0)) / 256.0;

        float ditherMask = pow(DitherMask(uv, resolution), uDitherPower);
        float dithStrength = uDitherStrength * 0.5;

        return clamp(c + dithStrength * avgDist * (ditherMask * 2.0 - 1.0), 0.0, 1.0);
    }

    vec3 Posterize(vec3 c, vec2 luv, vec2 resolution)
    {
        float steps = float(uColorCount);
        vec3 lookupColor = GetLookupColor(c, luv, resolution, steps * steps * steps);

        return floor(clamp(lookupColor, 0.0, 1.0) * (steps + 1.0)) / steps;
    }

    vec3 ColorMap(vec3 c, vec2 luv, vec2 resolution)
    {
        // The ENB reads the palette's colour count from the LUT's alpha; it only shifts
        // avgDist by ~1e-7, so a fixed count is used here.
        vec3 lookupColor = GetLookupColor(c, luv, resolution, 256.0);

        vec3 idx = floor(clamp(floor(lookupColor * 64.0) / 64.0, 0.0, 1.0) * 63.0 + 0.5);
        idx.z += 64.0 * float(uPalette - 1);

        return omw_Texture3D(retroPalettes, (idx + 0.5) / vec3(64.0, 64.0, 64.0 * PALETTE_COUNT)).rgb;
    }

    float edgeStr(vec2 uv)
    {
        vec2 lr = loRes();
        vec2 luv = lUv(uv);
        float center = omw_GetLinearDepth(pointUv(luv));
        float farthest = 0.0;

        for (int x = -1; x <= 1; x++)
        {
            for (int y = -1; y <= 1; y++)
            {
                if (x == 0 && y == 0)
                    continue;

                vec2 suv = (lr * luv + vec2(float(x), float(y))) / lr;
                farthest = max(farthest, omw_GetLinearDepth(pointUv(suv)));
            }
        }

        float depthDiff = SKYRIM_NEAR * (1.0 / center - 1.0 / farthest);
        return clamp(clamp(depthDiff, 0.0, 1.0) * EDGE_STR, 0.0, 1.0);
    }

    vec3 avgSample(vec2 uv)
    {
        vec2 lr = loRes();
        vec2 luv = lUv(uv);
        vec3 res = vec3(0.0);

        for (int x = -10; x <= 10; x++)
        {
            for (int y = -1; y <= 10; y++)
            {
                // y is negated: the ENB's texture space points down, OpenMW's points up.
                vec2 suv = (luv * lr + vec2(float(x), -float(y)) / 20.0) / lr;
                res += omw_GetLastShader(suv).rgb;
            }
        }

        res /= 21.0 * 12.0;

        res = RGBtoHSV(res);
        res.y = pow(res.y, SATPOW);
        res = HSVtoRGB(res);

        res = pow(res, vec3(BRIGHTPOW));

        float e = edgeStr(uv);
        float c = mix(CONTRAST, EDGE_CONTRAST, e);

        res = clamp(mix(vec3(0.5), res, c), 0.0, 1.0);

        if (uInvertEdge)
        {
            vec3 hsv = RGBtoHSV(res);
            hsv.z = 1.0 - hsv.z;
            res = mix(res, HSVtoRGB(hsv), e * 0.25);
        }

        return res;
    }

    void main()
    {
        vec2 uv = omw_TexCoord;
        vec2 luv = lUv(uv);
        vec3 res = avgSample(uv);

        if (uPalette == 0)
            res = Posterize(res, luv, loRes());
        else
            res = ColorMap(res, luv, loRes());

        omw_FragColor = vec4(res, 1.0);
    }
}

technique {
    passes = retro;
    description = "Pixelation, palette colour mapping and ordered dithering. Port of Retro Skyrim by monobelisk.";
    author = "monobelisk (original), OpenMW port";
    version = "1.0";
}
