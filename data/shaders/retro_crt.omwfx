uniform_int uResDiv {
    default = 5;
    min = 1;
    max = 48;
    step = 1;
    display_name = "Pixel size";
    description = "Size of a retro pixel in screen pixels, relative to 1080p. Keep it equal to 'Pixel size' in Retro.";
}

uniform_float uCurve {
    default = 0.03;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "Screen curve";
}

uniform_float uVignetteStrength {
    default = 1.0;
    min = 0.0;
    max = 6.0;
    step = 0.05;
    display_name = "Vignette strength";
}

uniform_float uScanlineStrength {
    default = 0.59;
    min = 0.0;
    max = 6.0;
    step = 0.01;
    display_name = "Scanline strength";
}

uniform_int uScanlineBlur {
    default = 2;
    min = 0;
    max = 5;
    step = 1;
    display_name = "Scanline blur samples";
    description = "Horizontal blur samples on each side.";
}

uniform_float uScanlineBlurStr {
    default = 0.35;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "Scanline blur strength";
}

uniform_float uPixelMaskStr {
    default = 0.1;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "CRT pixel mask strength";
}

fragment crt {
    // Retro CRT: screen curve, scanlines, horizontal scanline blur, RGB pixel mask and vignette.
    // OpenMW port of the post pass of "Retro Skyrim" by monobelisk (ENB, Skyrim SE, Nexus mod 38464).
    // Place it after retro.omwfx in the shader chain.

    omw_In vec2 omw_TexCoord;

    const float CURVE = 0.1;
    const float SCANLINE_GAP = 0.43;
    const vec3 LUMA = vec3(0.229, 0.587, 0.114);

    float resDiv()
    {
        return max(1.0, floor(float(uResDiv) / 1080.0 * omw.resolution.y + 0.5));
    }

    // Emulates the ENB's point sampler on a full resolution buffer.
    vec4 samplePoint(vec2 uv)
    {
        return omw_GetLastShader((floor(uv * omw.resolution) + 0.5) / omw.resolution);
    }

    vec2 CRTCurveUV(vec2 uv)
    {
        vec2 centerDist = abs((uv - 0.5) * 2.0);
        centerDist = centerDist * centerDist;
        float cornerStr = centerDist.x * centerDist.y * mix(0.0, CURVE, uCurve);
        vec2 cs = vec2(cornerStr);

        if (uv.x > 0.5)
            cs.x = -cs.x;
        if (uv.y > 0.5)
            cs.y = -cs.y;

        return uv - cs;
    }

    void DrawVignette(inout vec3 color, vec2 uv)
    {
        float vignette = uv.x * uv.y * (1.0 - uv.x) * (1.0 - uv.y);
        vignette = clamp(pow(24.0 * vignette, 0.3), 0.0, 1.0);
        color *= mix(1.0, vignette, uVignetteStrength);
    }

    // As in the ENB shader, this blurs the scene at retro pixel centres. The ENB read its
    // original (pre-retro) scene here; OpenMW shaders only see the previous shader's output,
    // so with Retro in front this blurs the retro image instead.
    void DrawHorizontalBlur(inout vec3 color, vec2 uv)
    {
        vec2 lores = omw.resolution / resDiv();
        vec2 luv = floor(uv * lores + 0.4999) / lores; // round(), ties down as in Retro
        float onePx = 1.0 / lores.x;

        float b = dot(LUMA, omw_GetLastShader(luv).rgb);

        vec3 blur = vec3(0.0);

        for (int x = -uScanlineBlur; x <= uScanlineBlur; x++)
        {
            if (x == 0)
                continue;

            vec2 suv = luv;
            suv.x += float(x) * onePx;

            // Integer division, as in the ENB shader: full strength except at the outermost sample.
            int dist = x < 0 ? -x : x; // GLSL 1.20 has no integer abs()
            float str = 1.0 - float(dist / uScanlineBlur);
            str *= uScanlineBlurStr;
            str *= 1.0 - pow(b, 0.1);
            str = pow(str, 1.1);

            blur += omw_GetLastShader(suv).rgb * str;
        }

        color = clamp(color + blur, 0.0, 1.0);
    }

    void DrawScanline(inout vec3 color, vec2 uv)
    {
        float div = resDiv();
        float yPos = uv.y * omw.resolution.y + 0.5 * div;

        // Position inside the retro pixel, 0 at its centre and 1 at its edges.
        float fracPos = abs(fract(yPos / div) * 2.0 - 1.0);

        // Resize gap
        fracPos = clamp(fracPos - SCANLINE_GAP, 0.0, 1.0) / (1.0 - SCANLINE_GAP);

        // Regulate blur with power
        fracPos = 1.0 - fracPos * fracPos;

        color *= mix(1.0, fracPos, uScanlineStrength);
    }

    void DrawCRTPixelMask(inout vec3 color, vec2 uv)
    {
        vec2 lores = omw.resolution / resDiv();
        float xPos = fract(uv.x * lores.x);

        vec3 mask = vec3(0.0);
        if (xPos <= 0.333)
            mask.r = 1.0;
        else if (xPos <= 0.666)
            mask.g = 1.0;
        else
            mask.b = 1.0;

        color = clamp(color + mask * 0.5 * uPixelMaskStr, 0.0, 1.0);
    }

    void main()
    {
        vec2 uv = CRTCurveUV(omw_TexCoord);
        vec3 res = samplePoint(uv).rgb;

        DrawHorizontalBlur(res, uv);
        DrawCRTPixelMask(res, uv);
        DrawVignette(res, uv);
        DrawScanline(res, uv);

        if (uv.x <= 0.0 || uv.x >= 1.0 || uv.y <= 0.0 || uv.y >= 1.0)
            res = vec3(0.0);

        omw_FragColor = vec4(res, 1.0);
    }
}

technique {
    passes = crt;
    description = "CRT screen curve, scanlines, pixel mask and vignette. Port of Retro Skyrim by monobelisk.";
    author = "monobelisk (original), OpenMW port";
    version = "1.0";
}
